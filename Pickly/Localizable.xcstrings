    "Apple requires a recent sign-in before Pickly can permanently delete this account. Your account stays active until you confirm.": {
      "comment": "A description of the Apple account deletion process.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple requires a recent sign-in before Pickly can permanently delete this account. Your account stays active until you confirm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple nécessite une connexion récente avant que Pickly puisse supprimer définitivement ce compte. Votre compte reste actif jusqu'à ce que vous confirmiez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple verlangt eine kürzliche Anmeldung, bevor Pickly dieses Konto dauerhaft löschen kann. Ihr Konto bleibt aktiv, bis Sie es bestätigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple requiere un registro reciente antes de que Pickly pueda eliminar permanentemente esta cuenta. Su cuenta permanece activa hasta que lo confirme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple richiede un recente accesso prima che Pickly possa eliminare definitivamente questo account. Il tuo account rimane attivo fino alla conferma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple requer um login recente antes que Pickly possa excluir permanentemente esta conta. A sua conta mantém-se activa até confirmar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple kræver en nylig sign-in før Pickly kan permanent slette denne konto. Din konto forbliver aktiv, indtil du bekræfter det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple wymaga niedawnego logowania, zanim Pickly będzie mógł trwale usunąć to konto. Twoje konto pozostaje aktywne do czasu potwierdzenia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple vyžaduje nedávné znamení, než Pickly může trvale smazat tento účet. Váš účet zůstane aktivní, dokud to nepotvrdíte."
          }
        }
      }
    },
    "Apple sign-in couldn't be completed. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sign-in couldn't be completed. Please try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inscription de la pomme n'a pas pu être terminée. Veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-Anmeldung konnte nicht abgeschlossen werden. Bitte versuchen Sie es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de Apple no pudo completarse. Por favor, inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso all'Apple non poteva essere completato. Per favore riprovate."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A entrada da Apple não pôde ser concluída. Por favor, tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sign-in kunne ikke afsluttes. Prøv igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znak Apple 'a nie mógł być ukończony. Proszę spróbować jeszcze raz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sign- in nemohl být dokončen. Prosím, zkuste to znovu."
          }
        }
      }
    },
    "Apple sign-in couldn't start. Make sure this iPhone is signed in to iCloud, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sign-in couldn't start. Make sure this iPhone is signed in to iCloud, then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement de Apple ne pouvait pas commencer. Assurez-vous que cet iPhone est connecté à iCloud, puis essayez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-Anmeldung konnte nicht starten. Stellen Sie sicher, dass dieses iPhone bei iCloud angemeldet ist, und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de Apple no podía empezar. Asegúrate de que este iPhone esté firmado en iCloud, y luego vuelve a intentarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso all'Apple non poteva iniziare. Assicurarsi che questo iPhone è firmato a iCloud, quindi riprovare."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A entrada da Apple não começou. Certifique-se de que este iPhone está conectado ao iCloud e tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sign-in kunne ikke starte. Sørg for, at denne iPhone er logget ind til iCloud, så prøv igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znak Apple 'a nie mógł zacząć. Upewnij się, że ten iPhone jest zalogowany do iCloud, a następnie spróbuj ponownie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-in nemohl začít. Ujistěte se, že tento iPhone je zapsán do iCloud, pak zkuste znovu."
          }
        }
      }
    },
    "Authentication is handled securely by Firebase.": {

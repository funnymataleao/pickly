    "For your security, confirm with Apple before deleting your account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your security, confirm with Apple before deleting your account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour votre sécurité, confirmez avec Apple avant de supprimer votre compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Ihrer Sicherheit bestätigen Sie dies mit Apple, bevor Sie Ihr Konto löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tu seguridad, confirma con Apple antes de eliminar tu cuenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la tua sicurezza, conferma con Apple prima di cancellare il tuo account."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sua segurança, confirme com a Apple antes de excluir sua conta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For din sikkerhed, bekræfte med Apple, før du sletter din konto."
          }
        },
        "pl": {

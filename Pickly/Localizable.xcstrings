    "Thanks. The product can now be reviewed for a future catalog update.": {
      "comment": "A message displayed after a product request is submitted.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks. The product can now be reviewed for a future catalog update."
          }
        },
        "fr": {
          "stringUnit": {

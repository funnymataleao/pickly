    "Product data can change. Check the package when a detail matters to you.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Product data can change. Check the package when a detail matters to you." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Les données du produit peuvent changer. Vérifiez l’emballage lorsqu’un détail est important pour vous." } },
        "de": { "stringUnit": { "state": "translated", "value": "Produktdaten können sich ändern. Prüfe die Verpackung, wenn dir ein Detail wichtig ist." } },
        "es": { "stringUnit": { "state": "translated", "value": "Los datos del producto pueden cambiar. Comprueba el envase cuando un detalle sea importante para ti." } },
        "it": { "stringUnit": { "state": "translated", "value": "I dati del prodotto possono cambiare. Controlla la confezione quando un dettaglio è importante per te." } },
        "pt-PT": { "stringUnit": { "state": "translated", "value": "Os dados do produto podem mudar. Verifique a embalagem quando um detalhe for importante para si." } },
        "da": { "stringUnit": { "state": "translated", "value": "Produktoplysninger kan ændre sig. Tjek emballagen, når en detalje er vigtig for dig." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Dane produktu mogą się zmieniać. Sprawdź opakowanie, gdy dany szczegół ma dla Ciebie znaczenie." } },
        "cs": { "stringUnit": { "state": "translated", "value": "Údaje o výrobku se mohou změnit. Pokud je pro vás některý údaj důležitý, zkontrolujte obal." } }
      }

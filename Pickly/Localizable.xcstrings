    "We couldn't find another verified product in the same category. Try the catalog again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't find another verified product in the same category. Try the catalog again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas trouvé d'autre produit vérifié dans la même catégorie. Essayez encore le catalogue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten kein anderes verifiziertes Produkt in derselben Kategorie finden. Versuchen Sie den Katalog erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos encontrar otro producto verificado en la misma categoría. Prueba el catálogo otra vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo trovato un altro prodotto verificato nella stessa categoria. Riprova il catalogo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos encontrar outro produto verificado na mesma categoria. Tenta o catálogo outra vez."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke finde et andet produkt i samme kategori. Prøv kataloget igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogliśmy znaleźć innego zweryfikowanego produktu w tej samej kategorii. Spróbuj jeszcze raz w katalogu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemohli jsme najít jiný ověřený výrobek ve stejné kategorii. Zkus znovu katalog."
          }
        }
      }
    },
    "We couldn't find another verified product in the same category. Your Plus access is active — try the catalog again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't find another verified product in the same category. Your Plus access is active — try the catalog again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas trouvé d'autre produit vérifié dans la même catégorie. Votre accès Plus est actif — essayez à nouveau le catalogue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten kein anderes verifiziertes Produkt in derselben Kategorie finden. Ihr Plus-Zugang ist aktiv - versuchen Sie den Katalog erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos encontrar otro producto verificado en la misma categoría. Tu acceso Plus está activo — prueba el catálogo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo trovato un altro prodotto verificato nella stessa categoria. Il vostro accesso Plus è attivo — riprovare il catalogo di nuovo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos encontrar outro produto verificado na mesma categoria. Seu acesso Plus está ativo — tente novamente o catálogo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke finde et andet produkt i samme kategori. Din Plus-adgang er aktiv - prøv kataloget igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogliśmy znaleźć innego zweryfikowanego produktu w tej samej kategorii. Twój dostęp Plus jest aktywny - spróbuj ponownie w katalogu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemohli jsme najít jiný ověřený výrobek ve stejné kategorii. Váš Plus přístup je aktivní - zkuste katalog znovu."
          }
        }
      }
    },
    "We couldn't restore purchases. Check your connection and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't restore purchases. Check your connection and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne pouvait pas restaurer les achats. Vérifiez votre connexion et essayez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten Käufe nicht wiederherstellen. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podíamos restaurar las compras. Revise su conexión e intente de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo potuto ripristinare gli acquisti. Controlla la connessione e riprova."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos restaurar as compras. Verifique sua conexão e tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke genoprette købene. Tjek din forbindelse og prøv igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogliśmy przywrócić zakupów. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemohli jsme obnovit nákupy. Zkontrolujte spojení a zkuste to znovu."
          }
        }
      }
    },
    "We couldn't verify that purchase. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't verify that purchase. Please try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne pouvait pas vérifier cet achat. Veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten diesen Kauf nicht überprüfen. Bitte versuchen Sie es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar esa compra. Por favor, inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo potuto verificare l'acquisto. Per favore riprovate."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pudemos verificar a compra. Por favor, tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke bekræfte købet. Prøv igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogliśmy zweryfikować tego zakupu. Proszę spróbować jeszcze raz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemohli jsme to ověřit. Prosím, zkuste to znovu."
          }
        }
      }
    },
    "We don't have enough nutrition or ingredient data to score this product confidently.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We don't have enough nutrition or ingredient data to score this product confidently."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas assez de données nutritionnelles ou d'ingrédients pour marquer ce produit avec confiance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben nicht genug Nährstoff- oder Zutatendaten, um dieses Produkt sicher zu bewerten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tenemos suficientes datos de nutrición o ingrediente para marcar este producto con confianza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo abbastanza dati nutrizionali o ingredienti per segnare questo prodotto con fiducia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não temos dados nutricionais ou de ingredientes suficientes para marcar este produto com confiança."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har ikke nok ernæring eller ingrediens data til at score dette produkt trygt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mamy wystarczającej ilości danych żywieniowych lub składników, aby z pewnością zdobyć ten produkt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemáme dostatek údajů o výživě nebo složkách, abychom tento produkt zaznamenali s jistotou."
          }
        }
      }
    },

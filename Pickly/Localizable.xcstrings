      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Apple, Google, or email. Account access is optional, and your local grocery data stays on this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Apple, Google ou e-mail. L'accès au compte est facultatif, et vos données d'épicerie locale restent sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Apple, Google oder E-Mail. Der Kontozugriff ist optional und Ihre lokalen Einkaufsdaten bleiben auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice Apple, Google o correo electrónico. El acceso a la cuenta es opcional, y sus datos locales de alimentación permanecen en este dispositivo."
          }

    "Product facts and some product images may come from Open Food Facts. Availability and accuracy can vary by product and region.": {
      "comment": "A description of the product data sources used in the app.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Product facts and some product images may come from Open Food Facts. Availability and accuracy can vary by product and region."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les faits sur les produits et certaines images de produits peuvent provenir de Open Food Facts. La disponibilité et la précision peuvent varier selon le produit et la région."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Produktfakten und einige Produktbilder können von Open Food Facts stammen. Verfügbarkeit und Genauigkeit können je nach Produkt und Region variieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hechos del producto y algunas imágenes del producto pueden provenir de los hechos alimentarios abiertos. La disponibilidad y la precisión pueden variar según el producto y la región."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I fatti del prodotto e alcune immagini del prodotto possono provenire da Open Food Facts. Disponibilità e precisione possono variare a seconda del prodotto e della regione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatos do produto e algumas imagens do produto podem vir de Open Food Facts. Disponibilidade e precisão podem variar por produto e região."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Produktfakta og nogle produktbilleder kan komme fra Open Food Facts. Tilgængelighed og nøjagtighed kan variere efter produkt og region."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fakty produktu i niektóre obrazy produktu mogą pochodzić z Open Food Facts. Dostępność i dokładność mogą się różnić w zależności od produktu i regionu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fakta o produktu a některé obrázky produktu mohou pocházet z Open Food Fakta. Dostupnost a přesnost se může lišit podle produktu a regionu."
          }
        }
      }
    },

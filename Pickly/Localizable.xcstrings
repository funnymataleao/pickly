    "Pickly can only assess the details available for this product. Try another item if you need a more complete comparison.": {
      "comment": "A description of the data missing for a product.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly can only assess the details available for this product. Try another item if you need a more complete comparison."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly ne peut évaluer que les détails disponibles pour ce produit. Essayez un autre élément si vous avez besoin d'une comparaison plus complète."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly kann nur die für dieses Produkt verfügbaren Details bewerten. Versuchen Sie ein anderes Element, wenn Sie einen vollständigeren Vergleich benötigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly sólo puede evaluar los detalles disponibles para este producto. Prueba otro artículo si necesitas una comparación más completa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly può solo valutare i dettagli disponibili per questo prodotto. Prova un altro prodotto se hai bisogno di un confronto più completo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly só pode avaliar os detalhes disponíveis para este produto. Tente outro item se precisar de uma comparação mais completa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly kan kun vurdere de oplysninger, der er tilgængelige for dette produkt. Prøv et andet element, hvis du har brug for en mere komplet sammenligning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Produkt może jedynie ocenić dostępne dane. Spróbuj innego elementu, jeśli potrzebujesz bardziej kompletne porównanie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly může posoudit pouze podrobnosti dostupné pro tento přípravek. Zkuste jinou položku, pokud potřebujete úplnější srovnání."
          }
        }
      }
    },
    "Pickly couldn't remove all server data. Your account is still active; please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly couldn't remove all server data. Your account is still active; please try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly ne pouvait pas supprimer toutes les données du serveur. Votre compte est toujours actif; veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly konnte nicht alle Serverdaten entfernen. Ihr Konto ist noch aktiv; bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly no pudo eliminar todos los datos del servidor. Su cuenta todavía está activa; por favor intente de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly non poteva rimuovere tutti i dati del server. Il tuo account è ancora attivo; si prega di riprovare."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível remover todos os dados do servidor. Sua conta ainda está ativa; tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly kunne ikke fjerne alle serverdata. Din konto er stadig aktiv; prøv venligst igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mógł usunąć wszystkich danych serwera. Twoje konto jest nadal aktywne; spróbuj ponownie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Picklyý nemohl odstranit všechna data serveru. Váš účet je stále aktivní; zkuste to prosím znovu."
          }
        }
      }
    },
    "Pickly does not sell personal information or use it for advertising tracking. Camera access is optional, and no contacts are requested.": {
      "comment": "A description of Pickly's data practices.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly does not sell personal information or use it for advertising tracking. Camera access is optional, and no contacts are requested."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly ne vend pas de renseignements personnels et ne les utilise pas pour le suivi de la publicité. L'accès aux caméras est facultatif et aucun contact n'est demandé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly verkauft keine persönlichen Daten oder verwendet sie für das Werbe-Tracking. Der Kamerazugriff ist optional und es werden keine Kontakte angefordert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly no vende información personal ni la utiliza para el seguimiento de publicidad. El acceso a la cámara es opcional y no se solicitan contactos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly non vende informazioni personali o lo utilizza per il tracciamento pubblicitario. L'accesso alla telecamera è facoltativo e non sono richiesti contatti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly não vende informações pessoais nem as usa para rastreamento publicitário. O acesso à câmera é opcional e nenhum contato é solicitado."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly ikke sælge personlige oplysninger eller bruge det til reklame sporing. Kameraets adgang er valgfri, og der kræves ingen kontakter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie sprzedaje danych osobowych ani nie używa ich do śledzenia reklam. Dostęp do kamery jest opcjonalny i nie wymaga się kontaktów."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Picklyý neprodává osobní údaje ani je nepoužívá pro sledování reklamy. Přístup do kamery je volitelný a nejsou požadovány žádné kontakty."
          }
        }
      }
    },
    "Pickly gives grocery products a 0–100 score using the nutrition and ingredient data available for that product. The score helps compare grocery options; it is not a safety rating.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly gives grocery products a 0–100 score using the nutrition and ingredient data available for that product. The score helps compare grocery options; it is not a safety rating."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournit à chaque épicerie un score de 0 à 100 en utilisant les données nutritionnelles et sur les ingrédients disponibles pour ce produit. Le score aide à comparer les options d'épicerie; ce n'est pas une cote de sécurité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly gibt Lebensmittelprodukten eine 0-100-Punktzahl mit den für dieses Produkt verfügbaren Nährwert- und Zutatendaten. Die Punktzahl hilft, Lebensmitteloptionen zu vergleichen; es ist keine Sicherheitsbewertung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly le da a los productos de comestibles una puntuación de 0 a 100 utilizando los datos de nutrición y ingredientes disponibles para ese producto. La puntuación ayuda a comparar las opciones de alimentación; no es una calificación de seguridad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly dà ai prodotti alimentari un punteggio 0–100 utilizzando i dati nutrizionali e ingredienti disponibili per quel prodotto. Il punteggio aiuta a confrontare le opzioni di spesa; non è una valutazione di sicurezza."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly dá aos produtos de supermercado uma pontuação de 0 a 100 usando os dados nutricionais e ingredientes disponíveis para esse produto. A pontuação ajuda a comparar opções de supermercado; não é uma classificação de segurança."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly giver købmandsprodukter en 0- 100 score ved hjælp af de ernærings- og ingrediensdata, der er tilgængelige for dette produkt. Scoren hjælper med at sammenligne købmandsoptioner; det er ikke en sikkerhedsvurdering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly daje produktom spożywczym wynik 0- 100 z wykorzystaniem danych żywieniowych i składników dostępnych dla tego produktu. Wynik pomaga porównać opcje spożywcze; nie jest to ocena bezpieczeństwa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly dává potravinářským produktům 0-100 skóre s použitím údajů o výživě a složkách dostupných pro tento produkt. Skóre pomáhá porovnat možnosti potravin; to není hodnocení bezpečnosti."
          }
        }
      }
    },
    "Pickly provides general grocery information, not medical advice. It does not diagnose, treat, cure, or prevent any disease. Check the package label for allergens and dietary needs, and consult a qualified healthcare professional before making medical decisions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly provides general grocery information, not medical advice. It does not diagnose, treat, cure, or prevent any disease. Check the package label for allergens and dietary needs, and consult a qualified healthcare professional before making medical decisions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly fournit des informations générales d'épicerie, pas des conseils médicaux. Il ne diagnostique, ne traite, ne guérit ou ne prévient aucune maladie. Vérifiez l'étiquette de l'emballage pour connaître les allergènes et les besoins alimentaires, et consultez un professionnel de la santé qualifié avant de prendre des décisions médicales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly bietet allgemeine Lebensmittelinformationen, keine medizinische Beratung. Es diagnostiziert, behandelt, heilt oder verhindert keine Krankheit. Überprüfen Sie das Packungsetikett auf Allergene und Ernährungsbedürfnisse und konsultieren Sie einen qualifizierten Arzt, bevor Sie medizinische Entscheidungen treffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly proporciona información general sobre la alimentación, no consejos médicos. No diagnostica, trata, cura ni previene ninguna enfermedad. Consulte la etiqueta del paquete para alérgenos y necesidades dietéticas, y consulte a un profesional sanitario calificado antes de tomar decisiones médicas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly fornisce informazioni generali sulla drogheria, non consigli medici. Non diagnostica, tratta, cura o previene alcuna malattia. Controllare l'etichetta del pacchetto per allergeni e esigenze alimentari, e consultare un professionista sanitario qualificato prima di prendere decisioni mediche."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly fornece informações gerais do supermercado, não conselhos médicos. Não diagnosticar, tratar, curar ou prevenir qualquer doença. Verifique o rótulo da embalagem para alérgenos e necessidades alimentares, e consulte um profissional de saúde qualificado antes de tomar decisões médicas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly giver generel købmand information, ikke medicinsk rådgivning. Det diagnosticerer, behandler, helbreder eller forebygger ingen sygdom. Kontroller pakkeetiketten for allergener og kostbehov, og rådfør dig med en kvalificeret sundhedsperson, før du træffer medicinske beslutninger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly dostarcza ogólnych informacji spożywczych, a nie porady medycznej. Nie diagnozuje, nie leczy, nie leczy i nie zapobiega żadnej chorobie. Przed podjęciem decyzji medycznych należy sprawdzić etykietę opakowania pod kątem alergenów i potrzeb żywieniowych oraz skonsultować się z wykwalifikowanym pracownikiem służby zdrowia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickly poskytuje obecné informace o potravinách, ne lékařské poradenství. Nediagnostikuje, neléčí, nevyléčí ani nezabraňuje žádné nemoci. Zkontrolujte štítek balíčku alergeny a dietní potřeby, a konzultovat kvalifikovaný zdravotnický pracovník před děláním lékařských rozhodnutí."
          }
        }
      }
    },

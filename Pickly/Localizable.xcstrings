    "Verdicts use fixed ranges: Great 85–100, Good 70–84, Okay 50–69, and Not great 0–49.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdicts use fixed ranges: Great 85–100, Good 70–84, Okay 50–69, and Not great 0–49."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les verdicts utilisent des gammes fixes: Great 85–100, Good 70–84, Ok 50–69 et Pas grand 0–49."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Urteile verwenden feste Bereiche: Große 85-100, Gute 70-84, Okay 50-69 und Nicht große 0-49."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los veredictos usan rangos fijos: Grandes 85–100, Bien 70–84, Vale 50–69, y No muy bien 0–49."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdicts usano gamme fisse: Grande 85–100, Buono 70–84, Ok 50–69, e Non ottimo 0–49."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereditos usam faixas fixas: Grande 85-100, Bom 70-84, Ok 50-69, e Não ótimo 0-49."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdicts bruger faste intervaller: Great 85- 100, Good 70- 84, Okay 50- 69, og ikke stor 0- 49."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werdykty używają stałych zakresów: Great 85- 100, Good 70- 84, Okay 50- 69, and Not great 0- 49."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdikt používá pevné rozmezí: Great 85-100, Good 70-84, Ok 50-69, a ne skvělé 0-49."
          }
        }
      }
    },

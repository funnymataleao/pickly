    "You can delete your Pickly account from the Account screen. Deleting the account also clears local saved products and preferences.": {
      "comment": "A description of the user's ability to delete their Pickly account.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can delete your Pickly account from the Account screen. Deleting the account also clears local saved products and preferences."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez supprimer votre compte Pickly de l'écran Compte. Supprimer le compte efface également les produits et les préférences enregistrés localement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können Ihr Pickly-Konto auf dem Kontobildschirm löschen. Das Löschen des Kontos löscht auch lokale gespeicherte Produkte und Präferenzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede eliminar su cuenta Pickly de la pantalla de la Cuenta. Eliminar la cuenta también aclara los productos y preferencias locales salvados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi eliminare il tuo account Pickly dalla schermata Account. Cancellare l'account elimina anche i prodotti e le preferenze salvate locali."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode excluir sua conta Pickly da tela Conta. Excluir a conta também limpa produtos e preferências salvos locais."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan slette din Pickly-konto fra skærmen Konto. Sletning af kontoen også rydder lokale gemte produkter og præferencer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz usunąć swoje konto z ekranu konta. Usuwanie konta usuwa również lokalne zapisane produkty i preferencje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete smazat svůj účet Pickly z obrazovky účtu. Smazání účtu také vymaže místní uložené produkty a preference."
          }
        }
      }
    },

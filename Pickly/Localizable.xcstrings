    "Product scores and explanations remain free. Try again when the App Store is reachable to unlock alternatives.": {
      "comment": "A description of the benefits of using Pickly Plus.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {

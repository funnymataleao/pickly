    "Always check the package. Community data may be incomplete.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Always check the package. Community data may be incomplete." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Vérifiez toujours l’emballage. Les données de la communauté peuvent être incomplètes." } },
        "de": { "stringUnit": { "state": "translated", "value": "Prüfe immer die Verpackung. Community-Daten können unvollständig sein." } },
        "es": { "stringUnit": { "state": "translated", "value": "Comprueba siempre el envase. Los datos de la comunidad pueden estar incompletos." } },
        "it": { "stringUnit": { "state": "translated", "value": "Controlla sempre la confezione. I dati della community potrebbero essere incompleti." } },
        "pt-PT": { "stringUnit": { "state": "translated", "value": "Verifique sempre a embalagem. Os dados da comunidade podem estar incompletos." } },

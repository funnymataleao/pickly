    "Get current goal-based and related matches as Pickly's catalog evolves.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get current goal-based and related matches as Pickly's catalog evolves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez les correspondances actuelles selon vos objectifs et les produits associés du catalogue Pickly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle zielbasierte und ähnliche Treffer aus dem Pickly-Katalog erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén coincidencias actuales según tus objetivos y productos relacionados del catálogo Pickly."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni abbinamenti attuali basati sui tuoi obiettivi e prodotti correlati dal catalogo Pickly."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha correspondências atuais com base nos seus objetivos e produtos relacionados do catálogo Pickly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få aktuelle målbaserede og relaterede resultater fra Pickly-kataloget."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj aktualne dopasowania według celów i podobne produkty z katalogu Pickly."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Získejte aktuální shody podle cílů a související produkty z katalogu Pickly."
          }
        }
      }
    },
    "Get current higher-scoring matches for this item as catalog data evolves.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get current higher-scoring matches for this item as catalog data evolves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez les produits mieux notés pour cet article à mesure que le catalogue évolue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Produkte mit höherer Punktzahl für diesen Artikel erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén productos con mejor puntuación para este artículo a medida que evoluciona el catálogo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni prodotti con un punteggio più alto per questo articolo mentre il catalogo si aggiorna."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha produtos com pontuação superior para este artigo à medida que o catálogo evolui."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få aktuelle produkter med højere point for denne vare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj produkty z wyższym wynikiem dla tego produktu wraz z rozwojem katalogu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",

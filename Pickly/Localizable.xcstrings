    "Camera access is optional. You can search the product catalog or enter a barcode manually instead.": {
      "comment": "A description of the user's choice to allow camera access for barcode scanning.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is optional. You can search the product catalog or enter a barcode manually instead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès aux caméras est facultatif. Vous pouvez rechercher le catalogue de produits ou entrer un code-barres manuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugang ist optional. Sie können stattdessen den Produktkatalog durchsuchen oder einen Barcode manuell eingeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara es opcional. Puedes buscar el catálogo de productos o introducir un código de barras manualmente."
          }
        },
        "it": {
          "stringUnit": {

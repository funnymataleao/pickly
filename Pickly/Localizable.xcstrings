            "value": "Utilise votre courriel et votre mot de passe pour créer ou ouvrir votre compte Pickly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet Ihre E-Mail und Ihr Passwort, um Ihr Pickly-Konto zu erstellen oder zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza tu correo electrónico y contraseña para crear o abrir tu cuenta Pickly."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza la tua email e la password per creare o aprire il tuo account Pickly."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa seu e-mail e senha para criar ou abrir sua conta Pickly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger din e-mail og adgangskode til at oprette eller åbne din Pickly-konto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa e-maila i hasła, aby utworzyć lub otworzyć swoje konto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá svůj e-mail a heslo k vytvoření nebo otevření vašeho Pickly účtu."
          }
        }
      }
    },
    "Usually fine, but simpler options may use fewer additives.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usually fine, but simpler options may use fewer additives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Habituellement, les options plus simples peuvent utiliser moins d'additifs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalerweise gut, aber einfachere Optionen können weniger Zusatzstoffe verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente bien, pero opciones más simples pueden usar menos aditivos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di solito le opzioni più semplici possono usare meno additivi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente bem, mas opções mais simples podem usar menos aditivos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalt fint, men enklere muligheder kan bruge færre tilsætningsstoffer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zazwyczaj w porządku, ale prostsze opcje mogą używać mniej dodatków."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvykle v pohodě, ale jednodušší možnosti mohou používat méně přísad."
          }
        }
      }
    },

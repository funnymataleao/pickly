    "Submitted product requests remain in Pickly's Cloudflare service while your account is active and are removed with the account.": {
      "comment": "A description of how product requests are managed when a user deletes their account.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitted product requests remain in Pickly's Cloudflare service while your account is active and are removed with the account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes de produit soumises restent dans le service Cloudflare de Pickly pendant que votre compte est actif et sont supprimées avec le compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesendete Produktanfragen bleiben im Cloudflare-Service von Pickly, während Ihr Konto aktiv ist und mit dem Konto entfernt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes de productos presentadas permanecen en el servicio Cloudflare de Pickly mientras su cuenta está activa y se eliminan con la cuenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste di prodotto inserite rimangono nel servizio Cloudflare di Pickly mentre il tuo account è attivo e viene rimosso con l'account."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As solicitações de produtos enviadas permanecem no serviço Cloudflare da Pickly enquanto sua conta está ativa e são removidas com a conta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsendt produktanmodninger forbliver i Picklys Cloudflare service, mens din konto er aktiv og fjernes med kontoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoszone żądania produktów pozostają w serwisie Cloudflare firmy Pickly, podczas gdy Twoje konto jest aktywne, i są usuwane wraz z kontem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podávané žádosti o výrobek zůstávají ve službě Pickly 's Cloudflare, zatímco váš účet je aktivní a jsou odstraněny s účtem."
          }
        }
      }
    },

    "Your subscription keeps live catalog matches unlocked. Compare products side by side whenever current product data supports it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription keeps live catalog matches unlocked. Compare products side by side whenever current product data supports it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement maintient les correspondances du catalogue accessibles. Comparez les produits côte à côte lorsque les données le permettent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deinem Abo bleiben aktuelle Katalogtreffer verfügbar. Vergleiche Produkte nebeneinander, wenn die Daten dies erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción mantiene disponibles las coincidencias del catálogo. Compara productos lado a lado cuando los datos lo permitan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento mantiene disponibili le corrispondenze del catalogo. Confronta i prodotti quando i dati lo consentono."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua subscrição mantém disponíveis as correspondências do catálogo. Compare produtos lado a lado quando os dados o permitirem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit abonnement holder aktuelle katalogresultater tilgængelige. Sammenlign produkter side om side, når dataene understøtter det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcja zapewnia dostęp do aktualnych dopasowań z katalogu. Porównuj produkty, gdy dane na to pozwalają."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatné zpřístupňuje aktuální shody z katalogu. Porovnávejte výrobky vedle sebe, pokud to dostupná data umožní."
          }
        }
      }
    },

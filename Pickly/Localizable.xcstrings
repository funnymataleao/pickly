        }
      }
    },
    "Get live catalog matches and compare what matters on every scan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get live catalog matches and compare what matters on every scan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accédez aux correspondances du catalogue et comparez l’essentiel à chaque scan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte aktuelle Katalogtreffer und vergleiche bei jedem Scan, was zählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén coincidencias actuales del catálogo y compara lo importante en cada escaneo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni corrispondenze aggiornate dal catalogo e confronta ciò che conta a ogni scansione."

    "Local saved products, history, and preferences remain on this device until you remove them, delete the app, or delete your account from Pickly.": {
      "comment": "A description of the data that the MVP app stores locally.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local saved products, history, and preferences remain on this device until you remove them, delete the app, or delete your account from Pickly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les produits, l'historique et les préférences enregistrés localement restent sur cet appareil jusqu'à ce que vous les supprimez, supprimez l'application ou supprimez votre compte de Pickly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale gespeicherte Produkte, Historie und Präferenzen bleiben auf diesem Gerät, bis Sie sie entfernen, die App löschen oder Ihr Konto bei Pickly löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los productos guardados locales, la historia y las preferencias permanecen en este dispositivo hasta eliminarlos, eliminar la aplicación o eliminar su cuenta de Pickly."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prodotti salvati locali, la storia e le preferenze rimangono su questo dispositivo fino a quando non li rimuovete, cancellate l'app o cancellate il vostro account da Pickly."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Produtos, histórico e preferências salvos locais permanecem neste dispositivo até que você os remova, exclua o aplicativo ou exclua sua conta do Pickly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale gemte produkter, historie og præferencer forbliver på denne enhed, indtil du fjerner dem, sletter appen, eller sletter din konto fra Pickly."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalnie zapisane produkty, historia i preferencje pozostają na tym urządzeniu do czasu ich usunięcia, usunięcia aplikacji lub usunięcia konta Pickly."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní uložené produkty, historie a preference zůstávají na tomto zařízení, dokud je neodstraníte, nevymažete aplikaci nebo nevymažete váš účet z Pickly."
          }
        }
      }
    },

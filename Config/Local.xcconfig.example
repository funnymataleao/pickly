// Copy this file to Local.xcconfig and replace the placeholders locally or in CI.
// In xcconfig files, keep the $()/ escape in URLs so // is not parsed as a comment.
FIREBASE_API_KEY = PASTE_FIREBASE_API_KEY
FIREBASE_APP_ID = PASTE_FIREBASE_APP_ID
FIREBASE_GCM_SENDER_ID = PASTE_FIREBASE_GCM_SENDER_ID
FIREBASE_PROJECT_ID = PASTE_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET = PASTE_FIREBASE_STORAGE_BUCKET
PICKLY_API_BASE_URL = https:/$()/api.example.com
GOOGLE_IOS_CLIENT_ID = PASTE_GOOGLE_IOS_CLIENT_ID
GOOGLE_SERVER_CLIENT_ID = PASTE_GOOGLE_SERVER_CLIENT_ID
GOOGLE_REVERSED_CLIENT_ID = PASTE_GOOGLE_REVERSED_CLIENT_ID
